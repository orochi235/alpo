{
  "name": "@msb235/alpo",
  "version": "0.3.0",
  "description": "Serve a library from its local checkout until a release carries what you need, then move the pin",
  "keywords": [
    "npm",
    "link",
    "local",
    "monorepo",
    "vite",
    "dependencies",
    "dogfooding",
    "esbuild",
    "swiftpm",
    "go"
  ],
  "license": "MIT",
  "author": "orochi235",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/alpo.git"
  },
  "homepage": "https://github.com/orochi235/alpo#readme",
  "bugs": "https://github.com/orochi235/alpo/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "alpo": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./tsconfig.json": "./dist/tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/empty-tsconfig.mjs",
    "prepare": "npm run build",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "magicast": "^0.5.5",
    "semver": "^7.8.6"
  }
}
